#!/usr/bin/env python3
"""Wayland-aware xclip bridge for XWayland apps (e.g. antigravity-bin) on ASCII-DE."""

import os
import subprocess
import sys


def candidate_sockets():
    runtime_dir = os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
    order = []
    env_wd = os.environ.get("WAYLAND_DISPLAY", "").strip()
    if env_wd:
        order.append(env_wd)
    for sock in ("wayland-ascii-0", "wayland-0"):
        if sock not in order:
            order.append(sock)
    try:
        for entry in sorted(os.listdir(runtime_dir)):
            if entry.startswith("wayland-") and not entry.endswith(".lock") and entry not in order:
                order.append(entry)
    except OSError:
        pass

    valid = []
    for sock in order:
        path = sock if sock.startswith("/") else os.path.join(runtime_dir, sock)
        if os.path.exists(path):
            valid.append(sock)
    return valid


def parse_args(argv):
    mode = None  # "in" or "out"
    selection = "primary"
    target = None
    rmlastnl = False

    i = 0
    positional = []
    while i < len(argv):
        arg = argv[i]
        if arg in ("-h", "-help", "--help"):
            print("Usage: xclip [OPTION] [FILE]...\nWayland wl-clipboard bridge.")
            sys.exit(0)
        elif arg in ("-version", "--version"):
            print("xclip version 0.13 (wl-clipboard bridge)")
            sys.exit(0)
        elif arg in ("-o", "-out", "--out"):
            mode = "out"
        elif arg in ("-i", "-in", "--in"):
            mode = "in"
        elif arg in ("-rmlastnl", "-r"):
            rmlastnl = True
        elif arg in ("-silent", "-quiet", "-verbose"):
            pass
        elif arg in ("-selection", "-sel"):
            if i + 1 < len(argv):
                i += 1
                val = argv[i].lower()
                if val.startswith("c"):
                    selection = "clipboard"
                elif val.startswith("s"):
                    selection = "secondary"
                else:
                    selection = "primary"
        elif arg in ("-t", "-target"):
            if i + 1 < len(argv):
                i += 1
                target = argv[i]
        elif arg in ("-d", "-display", "-l", "-loops", "-noutf8", "-wait"):
            if arg in ("-d", "-display", "-l", "-loops", "-wait") and i + 1 < len(argv):
                i += 1
        elif arg.startswith("-"):
            pass
        else:
            positional.append(arg)
        i += 1

    if mode is None:
        mode = "in"
    return mode, selection, target, rmlastnl, positional


def run_wl_paste(sock, selection, extra_args):
    env = os.environ.copy()
    env["WAYLAND_DISPLAY"] = sock
    cmd = ["wl-paste"]
    if selection == "primary":
        cmd.append("--primary")
    cmd.extend(extra_args)
    return subprocess.run(cmd, env=env, capture_output=True, timeout=3)


def handle_out(selection, target, rmlastnl):
    sockets = candidate_sockets()
    if not sockets:
        sys.stderr.write("Error: Can't open Wayland clipboard socket\n")
        return 1

    if target and target.upper() == "TARGETS":
        for sock in sockets:
            res = run_wl_paste(sock, selection, ["--list-types"])
            if res.returncode == 0 and res.stdout.strip():
                types = [line.strip() for line in res.stdout.decode("utf-8", errors="replace").splitlines() if line.strip()]
                out_lines = ["TARGETS"] + [t for t in types if t != "TARGETS"]
                sys.stdout.write("\n".join(out_lines) + "\n")
                return 0
        sys.stderr.write("Error: target TARGETS not available\n")
        return 1

    if target:
        for sock in sockets:
            lt = run_wl_paste(sock, selection, ["--list-types"])
            if lt.returncode == 0:
                avail = {line.strip() for line in lt.stdout.decode("utf-8", errors="replace").splitlines()}
                if target in avail:
                    res = run_wl_paste(sock, selection, ["--type", target])
                    if res.returncode == 0:
                        data = res.stdout[:-1] if (rmlastnl and res.stdout.endswith(b"\n")) else res.stdout
                        sys.stdout.buffer.write(data)
                        return 0
        for sock in sockets:
            res = run_wl_paste(sock, selection, ["--type", target])
            if res.returncode == 0:
                data = res.stdout[:-1] if (rmlastnl and res.stdout.endswith(b"\n")) else res.stdout
                sys.stdout.buffer.write(data)
                return 0
        sys.stderr.write(f"Error: target {target} not available\n")
        return 1

    for sock in sockets:
        res = run_wl_paste(sock, selection, ["--no-newline"] if rmlastnl else [])
        if res.returncode == 0:
            sys.stdout.buffer.write(res.stdout)
            return 0

    return 1


def handle_in(selection, target, rmlastnl, files):
    if files:
        chunks = []
        for path in files:
            with open(path, "rb") as fh:
                chunks.append(fh.read())
        payload = b"".join(chunks)
    else:
        payload = sys.stdin.buffer.read()

    if rmlastnl and payload.endswith(b"\n"):
        payload = payload[:-1]

    sockets = candidate_sockets()
    if not sockets:
        sys.stderr.write("Error: Can't open Wayland clipboard socket\n")
        return 1

    rc = 1
    for sock in sockets:
        env = os.environ.copy()
        env["WAYLAND_DISPLAY"] = sock
        cmd = ["wl-copy"]
        if selection == "primary":
            cmd.append("--primary")
        if target:
            cmd.extend(["--type", target])
        try:
            res = subprocess.run(cmd, input=payload, env=env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=3)
            if res.returncode == 0:
                rc = 0
        except Exception:
            pass
    return rc


def main():
    mode, selection, target, rmlastnl, files = parse_args(sys.argv[1:])
    if mode == "out":
        sys.exit(handle_out(selection, target, rmlastnl))
    else:
        sys.exit(handle_in(selection, target, rmlastnl, files))


if __name__ == "__main__":
    main()
